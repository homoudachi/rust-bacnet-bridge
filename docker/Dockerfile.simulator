FROM rust:1.85-alpine AS builder
RUN apk add --no-cache musl-dev pkgconfig openssl-dev
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY src/ src/
COPY examples/ examples/
RUN cargo build --release --examples

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /app/target/release/examples/lan_device_sim /usr/local/bin/
COPY --from=builder /app/target/release/examples/icomm_sim /usr/local/bin/
CMD ["lan_device_sim"]
