FROM rust:1.93-alpine AS builder
RUN apk add --no-cache musl-dev pkgconfig openssl-dev
WORKDIR /app
COPY . .
RUN cargo build --release --no-default-features --features hub

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /app/target/release/bacnet-bridge /usr/local/bin/
EXPOSE 443 8443
ENTRYPOINT ["bacnet-bridge", "hub"]
